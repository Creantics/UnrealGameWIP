// The state a surface takes behind the world wave's front (MF_WorldWaveState, built by FTBuildWaveMaterials and wired
// into the surface masters by FTWorldWave::AddState). The same geometry, its own material: behind the front the colour
// drains to a few percent of its saturation and darkens about a stop, the surface goes damp (smoother), a world-space
// grime and vertical leak stains under the storey lines and sills come over it, and the emissives die, except inside
// one or two keep spheres (the collection's WorldWaveKeep0/1: xyz cm, w radius cm, 0 off), where they turn cold.
// Positions are world cm, Z up. Functions only.

#pragma once

#include "/Plugin/FTLook/Private/Wave/Common.ush"

// How much a point is kept lit: 1 inside a keep sphere, fading out over its outer quarter.
float FTWaveKeep(float3 wp, float4 keep)
{
	if (keep.w <= 0.0)
	{
		return 0.0;
	}
	return saturate((keep.w - length(wp - keep.xyz)) / max(0.25 * keep.w, 1.0));
}

// The second world's surface over the first's, by m (FTWaveSecond). n: the world normal (the vertex normal is enough).
void FTWaveSurfaceState(float m, float3 wp, float3 n, float4 keep0, float4 keep1, inout float3 base, inout float rough,
	inout float3 emis)
{
	if (m <= 0.0)
	{
		return;
	}
	FTWaveFns W;
	n = n / max(length(n), 1e-3);
	float up = n.z;

	// Colour: near grey (7 % of the saturation kept), a faint cold lean, a stop down.
	float lum = dot(base, FTWaveLuma);
	float3 grey = lerp(lum.xxx, base, 0.07) * float3(0.97, 0.99, 1.03);

	// Grime: two octaves of world-space mottling, darker in the low cells.
	float g = 0.6 * W.VNoise3(wp / 150.0, 51u) + 0.4 * W.VNoise3(wp / 35.0, 52u);
	float grime = lerp(0.7, 1.05, g);

	// Leak stains on walls: vertical streaks hanging from every storey line (about 3 m) and fading down it, plus long
	// run-off over the whole face. u runs along the wall.
	float wall = 1.0 - smoothstep(0.3, 0.6, abs(up));
	float2 h = n.xy / max(length(n.xy), 1e-3);
	float u = dot(wp.xy, float2(-h.y, h.x));
	float storey = frac(wp.z / 300.0);
	float under = smoothstep(0.2, 0.95, storey) * (1.0 - smoothstep(0.975, 1.0, storey));
	float streak = smoothstep(0.52, 0.82, W.VNoise2(float2(u / 7.0, wp.z / 260.0), 53u))
		* (0.55 + 0.45 * W.VNoise2(float2(u / 2.5, wp.z / 90.0), 54u));
	float runoff = smoothstep(0.58, 0.9, W.VNoise2(float2(u / 18.0, wp.z / 700.0), 55u));
	float leak = wall * saturate(under * streak + 0.45 * runoff);

	// Ground: wet dark patches where the grime is low.
	float ground = smoothstep(0.5, 0.85, up);
	float puddle = ground * smoothstep(0.55, 0.25, g);

	float3 newBase = grey * 0.5 * grime * (1.0 - 0.5 * leak) * (1.0 - 0.25 * puddle);
	float damp = lerp(0.08, 0.18, ground) + 0.1 * leak + 0.1 * puddle;
	float newRough = saturate(rough - damp);

	// Emissives die, except a kept source, which turns cold.
	float kept = max(FTWaveKeep(wp, keep0), FTWaveKeep(wp, keep1));
	float3 newEmis = kept * dot(emis, FTWaveLuma) * float3(0.72, 0.86, 1.0) * 1.3;

	base = lerp(base, newBase, m);
	rough = lerp(rough, newRough, m);
	emis = lerp(emis, newEmis, m);
}

// Seconds since the new world's edge passed a point: its distance behind the edge over the street preset's front speed
// near the eye (40 m/s easing to 17.5 m/s past 20 m: about 20 m/s where the takes stand).
static const float kWaveFrontCmPerS = 2000.0;

// Front A (ink in water): the wet ink the front leaves, 0..1, at tau seconds after the edge passed. The core's coat on
// everything for 0.1-0.35 s; on walls, runs in 3-9 cm columns whose pattern falls at about 1 m/s and dries out by 1.15 s;
// on the ground, pools that shrink and soak in by about 1.2 s. n: the world normal.
float FTWaveWetInk(float tau, float3 wp, float3 n)
{
	if (tau < -0.05 || tau > 1.4)
	{
		return 0.0;
	}
	FTWaveFns W;
	n = n / max(length(n), 1e-3);
	float wall = 1.0 - smoothstep(0.3, 0.6, abs(n.z));
	float ground = smoothstep(0.5, 0.85, n.z);
	float coat = 1.0 - smoothstep(0.1, 0.35, tau + 0.15 * W.VNoise3(wp / 60.0, 91u));
	float2 h = n.xy / max(length(n.xy), 1e-3);
	float u = dot(wp.xy, float2(-h.y, h.x));
	float column = smoothstep(0.4, 0.62, W.VNoise2(float2(u / 9.0, 0.5), 92u)) * smoothstep(0.3, 0.55, W.VNoise2(float2(u / 3.0, 1.5), 93u));
	float fall = W.VNoise2(float2(u / 9.0, (wp.z + 100.0 * tau) / 120.0), 94u);
	float run = wall * column * smoothstep(0.35, 0.55, fall) * (1.0 - smoothstep(0.7, 1.15, tau));
	float pond = W.VNoise3(wp / 90.0, 95u);
	float pool = ground * smoothstep(0.42 + 0.25 * tau, 0.58 + 0.25 * tau, pond) * (1.0 - smoothstep(0.8, 1.25, tau));
	return saturate(max(coat, max(run, pool)));
}

// The whole surface state: the second world's (FTWaveSurfaceState) by the front's share at the point, then for front A
// (origin.w 1) the wet ink over it. active: a wave is set.
void FTWaveSurface(float3 wp, float3 n, float4 origin, float active, float r, float w, float direction, float t, float4 keep0,
	float4 keep1, inout float3 base, inout float rough, inout float3 emis)
{
	// No wave (the collection's WorldWaveOriginScreen.w 0, uniform over the draw): one test and the master's own values.
	[branch] if (active < 0.5)
	{
		return;
	}
	float m = FTWaveSecond(wp, origin.xyz, r, w, direction, t, active);
	FTWaveSurfaceState(m, wp, n, keep0, keep1, base, rough, emis);
	if (active > 0.5 && origin.w > 0.5 && origin.w < 1.5 && r > 0.0)
	{
		FTWaveFns W;
		float e = W.Edge(r, max(w, 1.0), float3(0.0, 0.0, 0.0), t, wp);
		float ink = FTWaveWetInk((e - length(wp - origin.xyz)) / kWaveFrontCmPerS, wp, n);
		base *= 1.0 - 0.96 * ink;
		rough = lerp(rough, 0.06, ink);
		emis *= 1.0 - ink;
	}
}
