# Run as: cmake -DSOURCE_DIR=<Source/ForgottenThird> -DTABLE=<Data/Loc/en/ui.json> -P CheckUiTextKeys.cmake
# Every interface-text key the game uses (FTUiText k...(TEXT("key")) or FTUiText::Lookup(TEXT("key")))
# must be in the English table, and every key in the table must be used somewhere.

file(READ "${TABLE}" table)
string(JSON strings GET "${table}" strings)
string(JSON count LENGTH "${strings}")
set(known "")
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON key MEMBER "${strings}" ${i})
        list(APPEND known "${key}")
    endforeach()
endif()

file(GLOB sources "${SOURCE_DIR}/*.cpp" "${SOURCE_DIR}/*.h")
set(used "")
foreach(path IN LISTS sources)
    file(READ "${path}" content)
    string(REGEX MATCHALL "FTUiText(::Lookup\\(| k[A-Za-z0-9_]+\\()TEXT\\(\"[a-z0-9_.]+\"\\)" hits "${content}")
    foreach(hit IN LISTS hits)
        string(REGEX REPLACE ".*TEXT\\(\"([a-z0-9_.]+)\"\\)" "\\1" key "${hit}")
        list(APPEND used "${key}")
    endforeach()
endforeach()
list(REMOVE_DUPLICATES used)

set(problems "")
foreach(key IN LISTS used)
    if(NOT key IN_LIST known)
        string(APPEND problems "  used but not in ${TABLE}: ${key}\n")
    endif()
endforeach()
foreach(key IN LISTS known)
    if(NOT key IN_LIST used)
        string(APPEND problems "  in the table but never used: ${key}\n")
    endif()
endforeach()

if(problems)
    message(FATAL_ERROR "Interface text keys out of sync:\n${problems}")
endif()
list(LENGTH used n)
message(STATUS "Interface text: ${n} keys, all in the English table")
