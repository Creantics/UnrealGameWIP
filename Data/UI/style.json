{
  "version": 1,
  "note": "The game UI's style table (Core/include/ftcore/UiStyle.h). Colours are sRGB hex. Text px are at 1080p before the player's text scale; nothing draws below min_text_px at 1080p or min_text_px_absolute at any height. Import checks contrast on the backing over a white picture that text on its hairline edge reads 4.5:1 over white, and that danger, ally and weak_point each have their own cue shape. The look is this table plus the stroke painters (Core UiStroke). The lattice and unwritten values are provisional until those worlds' UI passes.",
  "layers": { "hairlines": true, "plates": false, "world_anchored": false, "letterbox": true },
  "line_weight": 3,
  "backing_default": 0.75,
  "backing_soft": { "hud": 0.3, "dialogue": 0.42, "options_contrast": 3, "options_max": 0.65 },
  "edge": { "color": "#0A0908E6", "px": 1, "text": 0.6 },
  "meter": "line",
  "lead_marks": ["knuckles", "cylinder", "mask"],
  "fade": { "in": 0.15, "rest": 2.5, "out": 0.6, "rest_alpha": 0.35 },
  "budget": { "rest": 3, "marks": 10, "hint": 3 },
  "word_luma_floor": 0.45,
  "tone": { "hold": 0.5, "fade": 0.1, "margin": 1.15, "word_luma_ceiling": 0.1 },
  "min_text_px": 18,
  "min_text_px_absolute": 14,
  "worlds": {
    "solhaven":  { "ink": "#F3EEE6", "ink_dim": "#D2CBBF", "backing": "#0A0806", "track": "#FFFFFF4D", "accent": "#E9B36B", "accent2": "#C9643C", "danger": "#FF7A5C", "ally": "#8FD3B4", "weak_point": "#FFE08A", "plate": "bronze" },
    "lattice":   { "ink": "#EEF4F6", "ink_dim": "#C4D1D6", "backing": "#05090C", "track": "#FFFFFF4D", "accent": "#8FD6E8", "accent2": "#A88BE0", "danger": "#FF7A86", "ally": "#9BE3B0", "weak_point": "#FFE08A", "plate": "form_slip" },
    "unwritten": { "ink": "#F2ECE0", "ink_dim": "#D0C8B8", "backing": "#0B0907", "track": "#FFFFFF4D", "accent": "#E6DDCB", "accent2": "#9E3B2E", "danger": "#FF7A66", "ally": "#9CC7A4", "weak_point": "#F4D58A", "plate": "torn_page" }
  },
  "palettes": {
    "protan":        { "danger": "#F0A030", "ally": "#7CC4F0", "weak_point": "#F5EE70" },
    "deutan":        { "danger": "#F0A030", "ally": "#7CC4F0", "weak_point": "#F5EE70" },
    "tritan":        { "danger": "#FF7A4A", "ally": "#40C8B0", "weak_point": "#F5A0C8" },
    "high_contrast": { "ink": "#FFFFFF", "ink_dim": "#FFFFFF", "backing": "#000000", "track": "#FFFFFF73", "danger": "#FF8A00", "ally": "#00E0FF", "weak_point": "#FFFF00" }
  },
  "text": {
    "title":    { "font": "serif_sc_bold", "px": 40, "tracking": 0.08, "upper": false },
    "heading":  { "font": "serif_sc_bold", "px": 28, "tracking": 0.06, "upper": false },
    "label":    { "font": "serif_sc",      "px": 26, "tracking": 0.08, "upper": false },
    "value":    { "font": "serif_sc_bold", "px": 28, "tracking": 0,    "upper": false },
    "subtitle": { "font": "serif",         "px": 36, "tracking": 0,    "upper": false },
    "speaker":  { "font": "serif_sc_bold", "px": 26, "tracking": 0.08, "upper": false },
    "prompt":   { "font": "serif",         "px": 26, "tracking": 0.02, "upper": false },
    "popup":    { "font": "serif_sc_bold", "px": 30, "tracking": 0.04, "upper": false },
    "verb":     { "font": "serif_sc_bold", "px": 27, "tracking": 0.22, "upper": true }
  },
  "cues": { "danger": "triangle", "ally": "circle", "weak_point": "diamond" }
}
