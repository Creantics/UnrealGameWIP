{
  "version": 1,
  "note": "The game UI's style table (Core/include/ftcore/UiStyle.h). Colours are sRGB hex. Text px are at 1080p before the player's text scale; nothing draws below min_text_px at 1080p or min_text_px_absolute at any height. Import checks contrast on the backing over a white picture and that danger, ally and weak_point each have their own cue shape.",
  "layers": { "hairlines": true, "plates": false, "world_anchored": false, "letterbox": true },
  "line_weight": 3,
  "backing_default": 0.75,
  "min_text_px": 18,
  "min_text_px_absolute": 14,
  "worlds": {
    "solhaven":  { "ink": "#F3EEE6", "ink_dim": "#D2CBBF", "backing": "#0A0806", "track": "#FFFFFF4D", "accent": "#E9B36B", "accent2": "#C9643C", "danger": "#FF7A5C", "ally": "#8FD3B4", "weak_point": "#FFE08A", "plate": "bronze" },
    "lattice":   { "ink": "#EEF4F6", "ink_dim": "#C4D1D6", "backing": "#05090C", "track": "#FFFFFF4D", "accent": "#8FD6E8", "accent2": "#A88BE0", "danger": "#FF7A86", "ally": "#9BE3B0", "weak_point": "#FFE08A", "plate": "form_slip" },
    "unwritten": { "ink": "#F2ECE0", "ink_dim": "#D0C8B8", "backing": "#0B0907", "track": "#FFFFFF4D", "accent": "#E6DDCB", "accent2": "#9E3B2E", "danger": "#FF7A66", "ally": "#9CC7A4", "weak_point": "#F4D58A", "plate": "torn_page" }
  },
  "palettes": {
    "protan":        { "danger": "#F0A030", "ally": "#7CC4F0", "weak_point": "#F5EE70" },
    "deutan":        { "danger": "#F0A030", "ally": "#7CC4F0", "weak_point": "#F5EE70" },
    "tritan":        { "danger": "#FF7A4A", "ally": "#40C8B0", "weak_point": "#F5A0C8" },
    "high_contrast": { "ink": "#FFFFFF", "ink_dim": "#FFFFFF", "backing": "#000000", "track": "#FFFFFF73", "danger": "#FF8A00", "ally": "#00E0FF", "weak_point": "#FFFF00" }
  },
  "text": {
    "title":    { "font": "sans_bold", "px": 44, "tracking": 0.08, "upper": true },
    "heading":  { "font": "sans_bold", "px": 28, "tracking": 0.06, "upper": true },
    "label":    { "font": "sans",      "px": 18, "tracking": 0.12, "upper": true },
    "value":    { "font": "sans_bold", "px": 24, "tracking": 0,    "upper": false },
    "subtitle": { "font": "sans",      "px": 36, "tracking": 0,    "upper": false },
    "speaker":  { "font": "sans_bold", "px": 24, "tracking": 0.12, "upper": true },
    "prompt":   { "font": "sans",      "px": 20, "tracking": 0.04, "upper": false },
    "popup":    { "font": "sans_bold", "px": 28, "tracking": 0.04, "upper": true }
  },
  "cues": { "danger": "triangle", "ally": "circle", "weak_point": "diamond" }
}
